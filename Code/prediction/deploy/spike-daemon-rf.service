# Production RF detector unit (mycroft, user dlee) — the SINGLE detector.
# Runs the off-box-trained RF scorer only: no on-box RF refit (the legacy
# live_detector refit loop self-contaminates power traces). Owns production
# measurement power_spike_prediction and the actuator-facing risk flag
# consumed by ramp.c / rapl_capper.
#
# Why a user unit (not system): mycroft runs SELinux Enforcing and /home/dlee
# is 0700, so a system-domain service is denied exec of the venv python under
# /home (203/EXEC). The scorer needs no root — only InfluxDB reads + a token
# file. `loginctl enable-linger dlee` keeps it up across logout/reboot.
# Restart=always + RestartSec=30 backstops the 2026-07-06 refit-storm class
# (InfluxDB outage -> crash loop, no backoff); the scorer also retries in-process.
[Unit]
Description=Single RF spike-risk detector (off-box trained scorer)
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/dlee/code/Model/analysis
ExecStart=/home/dlee/code/Model/analysis/.venv/bin/python -u -m detectors.random_forest.scorer --measurement power_spike_prediction --risk-file /home/dlee/code/Model/analysis/data/spike_risk.flag
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
