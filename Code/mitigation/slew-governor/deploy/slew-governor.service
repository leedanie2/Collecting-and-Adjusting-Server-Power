# LIVE slew governor user unit (mycroft, user dlee) -- the power smoother.
#
# User unit for the same reason as rapl-capper.service: mycroft's system
# service context cannot exec code from /home/dlee (SELinux), and root is
# needed only for RAPL sysfs writes, granted via one exact sudoers entry:
#
#   deploy/slew-governor.sudoers -> /etc/sudoers.d/slew-governor
#
# Engage-gated: caps sit fully STOCK while power is quiet; the hug+slew (and
# the SCHED_IDLE ballast that fills dips) act only across transitions and
# while the RF detector's risk flag is high below the plateau. Ballast policy
# (2026-07-17 decision): always on with the governor.
#
# Do not run beside rapl-capper*.service -- both write the same RAPL files.
[Unit]
Description=RAPL slew governor (power smoother: dynamic ramps, ballast, risk pre-engage)
After=spike-daemon-rf.service
Wants=spike-daemon-rf.service
Conflicts=rapl-capper.service rapl-capper-dry-run.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/dlee/code/Model/analysis
ExecStartPre=/usr/bin/mkdir -p /home/dlee/code/Model/analysis/actuators/data
ExecStart=/usr/bin/sudo -n /home/dlee/code/Model/analysis/.venv/bin/python -u -m actuators.rapl_capper --slew --ballast --ballast-w-per-core 3.26 --ballast-max-cores 64 --no-engage-on-dips --risk-file /home/dlee/code/Model/analysis/data/spike_risk.flag --events /home/dlee/code/Model/analysis/actuators/data/slew_events.jsonl
KillSignal=SIGTERM
TimeoutStopSec=15
# Restart=no on purpose: a restart after a dirty exit could snapshot
# already-capped limits as "originals" (the startup dirty-snapshot guard
# FATALs, but don't lean on it in a restart loop). Session-2 recovery drill
# decides whether persistent original-state recovery unlocks Restart=on-failure.
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
