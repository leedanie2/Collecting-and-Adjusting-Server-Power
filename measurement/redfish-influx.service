# Out-of-band BMC telemetry. Unlike the RAPL samplers this needs no root on the
# host -- it reaches the iLO over the network -- but it does need the BMC
# address, a read-only BMC account, and that account's password in
# ~/.secrets/bmc_password.txt (0600).

[Unit]
Description=Stream HPE iLO5 Redfish telemetry to InfluxDB
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /path/to/measurement/redfish_influx.py --system mycroft
Environment=BMC_IP=<bmc-address>
Environment=BMC_USER=<read-only-bmc-account>
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
