# Telemetry caches are regenerated from InfluxDB by telemetry/pull_cache.py and
# telemetry/pull_process_cache.py -- hundreds of MB, not committed.
telemetry.csv
telemetry_procs.csv
hf_upstream.csv
*.log
# Dated training pickles are large and superseded; the exported plain-text
# forest that the C inference path reads is committed instead.
models/*.pkl
models/spike_model_current
# Runtime risk flags written by the daemons.
*.flag
